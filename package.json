{
  "name": "qingye",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "清页 — 一键转存网页为净文档。iOS / Android / 手表 / 智能戒指手杖",
  "scripts": {
    "build": "node scripts/build-web.js",
    "start": "npm run build && npx --yes serve www -p 5191",
    "test": "node --test test/*.test.js",
    "sync:android": "npm run build && npx cap sync android",
    "open:android": "npx cap open android",
    "apk:debug": "npm run sync:android && node ../../tools/run-gradle-android.mjs assembleDebug",
    "mobile:android": "npm run sync:android && npm run open:android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/share": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "esbuild": "^0.24.2",
    "jsdom": "^25.0.1"
  }
}
